PORT=3001
NODE_ENV=production
ADMIN_PASSWORD=photoquiz
ALLOWED_ORIGINS=
# Tamaño máximo por foto en el backend (MB). Mantener por debajo del límite del proxy inverso.
MAX_UPLOAD_MB=5
# Proxies de confianza para X-Forwarded-For (proxy inverso + red docker en IPs privadas).
TRUST_PROXY=loopback, linklocal, uniquelocal
