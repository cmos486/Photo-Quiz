# Photo Quiz — copia este fichero a .env y ajústalo.

# Contraseña del panel admin (?view=admin). CÁMBIALA.
ADMIN_PASSWORD=photoquiz

# Tamaño máximo por foto en MB (por encima: 413 con JSON). Debe ser menor que el límite de
# tamaño de petición del reverse proxy. Cambiarlo no requiere rebuild: docker compose up -d
MAX_UPLOAD_MB=5

# Proxies de confianza para X-Forwarded-For (sintaxis "trust proxy" de Express).
# Por defecto confía en redes privadas (reverse proxy + red de Docker).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Orígenes CORS para Socket.io, separados por comas (vacío = todos).
# Nota: docker-compose.yml no pasa esta variable al contenedor; añádela a su
# sección "environment" si la necesitas.
ALLOWED_ORIGINS=

# PORT y NODE_ENV están fijados en docker-compose.yml (3001 / production).
